{
  "id": "com.erikrichardson.acswebrtc",
  "version": "0.1.0",
  "compatibility": ">=12.7.0",
  "runtime": "nodejs",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "brandColor": "#1f3a5f",
  "name": {
    "en": "Camera Station Live"
  },
  "description": {
    "en": "Live video from AXIS Camera Station Pro over WebRTC, straight from your recording server."
  },
  "category": [
    "security"
  ],
  "tags": {
    "en": [
      "axis",
      "camera station",
      "acs",
      "webrtc",
      "camera",
      "live video"
    ]
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "permissions": [],
  "author": {
    "name": "Erik Richardson",
    "email": "er1kr1984@gmail.com"
  },
  "api": {
    "getSettingsState": {
      "method": "GET",
      "path": "/settings"
    },
    "saveServer": {
      "method": "POST",
      "path": "/servers"
    },
    "testServer": {
      "method": "POST",
      "path": "/servers/:id/test"
    },
    "trustServer": {
      "method": "POST",
      "path": "/servers/:id/trust"
    },
    "removeServer": {
      "method": "DELETE",
      "path": "/servers/:id"
    },
    "setDiagnostics": {
      "method": "POST",
      "path": "/diagnostics"
    },
    "newEventKey": {
      "method": "POST",
      "path": "/event-key"
    },
    "getLogs": {
      "method": "GET",
      "path": "/logs"
    },
    "getPreviousLogs": {
      "method": "GET",
      "path": "/previous-logs"
    },
    "receiveEventGet": {
      "method": "GET",
      "path": "/event",
      "public": true
    },
    "receiveEventPost": {
      "method": "POST",
      "path": "/event",
      "public": true
    }
  }
}
