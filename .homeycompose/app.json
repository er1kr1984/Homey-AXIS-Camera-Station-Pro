{
  "id": "com.erikrichardson.acswebrtc",
  "version": "1.0.2",
  "compatibility": ">=12.7.0",
  "runtime": "nodejs",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "brandColor": "#f2b705",
  "name": {
    "en": "Live view for AXIS Camera Station Pro",
    "sv": "Livebild för AXIS Camera Station Pro",
    "de": "Livebild für AXIS Camera Station Pro",
    "nl": "Livebeeld voor AXIS Camera Station Pro"
  },
  "description": {
    "en": "Live video from AXIS Camera Station Pro over WebRTC, straight from your recording server.",
    "sv": "Livevideo från AXIS Camera Station Pro via WebRTC, direkt från din inspelningsserver.",
    "de": "Live-Video von AXIS Camera Station Pro über WebRTC, direkt von Ihrem Aufnahmeserver.",
    "nl": "Live video van AXIS Camera Station Pro via WebRTC, rechtstreeks van je opnameserver."
  },
  "category": [
    "security"
  ],
  "tags": {
    "en": [
      "axis",
      "camera station",
      "acs",
      "webrtc",
      "camera",
      "live video"
    ]
  },
  "images": {
    "small": "/assets/images/small.jpg",
    "large": "/assets/images/large.jpg",
    "xlarge": "/assets/images/xlarge.jpg"
  },
  "permissions": [],
  "author": {
    "name": "Erik Richardson",
    "email": "er1kr1984@gmail.com"
  },
  "support": "https://github.com/er1kr1984/Homey-AXIS-Camera-Station-Pro/issues",
  "bugs": {
    "url": "https://github.com/er1kr1984/Homey-AXIS-Camera-Station-Pro/issues"
  },
  "source": "https://github.com/er1kr1984/Homey-AXIS-Camera-Station-Pro",
  "homepage": "https://github.com/er1kr1984/Homey-AXIS-Camera-Station-Pro",
  "api": {
    "getSettingsState": {
      "method": "GET",
      "path": "/settings"
    },
    "saveServer": {
      "method": "POST",
      "path": "/servers"
    },
    "testServer": {
      "method": "POST",
      "path": "/servers/:id/test"
    },
    "trustServer": {
      "method": "POST",
      "path": "/servers/:id/trust"
    },
    "removeServer": {
      "method": "DELETE",
      "path": "/servers/:id"
    },
    "setDiagnostics": {
      "method": "POST",
      "path": "/diagnostics"
    },
    "newEventKey": {
      "method": "POST",
      "path": "/event-key"
    },
    "getLogs": {
      "method": "GET",
      "path": "/logs"
    },
    "getPreviousLogs": {
      "method": "GET",
      "path": "/previous-logs"
    },
    "receiveEventGet": {
      "method": "GET",
      "path": "/event",
      "public": true
    },
    "receiveEventPost": {
      "method": "POST",
      "path": "/event",
      "public": true
    }
  }
}
