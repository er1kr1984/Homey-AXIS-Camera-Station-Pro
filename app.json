{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "com.erikrichardson.acswebrtc",
  "version": "0.1.0",
  "compatibility": ">=12.7.0",
  "runtime": "nodejs",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "brandColor": "#1f3a5f",
  "name": {
    "en": "Camera Station Live"
  },
  "description": {
    "en": "Live video from AXIS Camera Station Pro over WebRTC, straight from your recording server."
  },
  "category": [
    "security"
  ],
  "tags": {
    "en": [
      "axis",
      "camera station",
      "acs",
      "webrtc",
      "camera",
      "live video"
    ]
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "permissions": [],
  "author": {
    "name": "Erik Richardson",
    "email": "er1kr1984@gmail.com"
  },
  "api": {
    "getSettingsState": {
      "method": "GET",
      "path": "/settings"
    },
    "saveServer": {
      "method": "POST",
      "path": "/servers"
    },
    "testServer": {
      "method": "POST",
      "path": "/servers/:id/test"
    },
    "trustServer": {
      "method": "POST",
      "path": "/servers/:id/trust"
    },
    "removeServer": {
      "method": "DELETE",
      "path": "/servers/:id"
    },
    "setDiagnostics": {
      "method": "POST",
      "path": "/diagnostics"
    },
    "newEventKey": {
      "method": "POST",
      "path": "/event-key"
    },
    "getLogs": {
      "method": "GET",
      "path": "/logs"
    },
    "getPreviousLogs": {
      "method": "GET",
      "path": "/previous-logs"
    },
    "receiveEventGet": {
      "method": "GET",
      "path": "/event",
      "public": true
    },
    "receiveEventPost": {
      "method": "POST",
      "path": "/event",
      "public": true
    }
  },
  "flow": {
    "triggers": [
      {
        "title": {
          "en": "Camera Station sent an event"
        },
        "hint": {
          "en": "Runs for every event Camera Station sends to Homey, also for sources that are not added as devices (door stations, action buttons, ...)."
        },
        "tokens": [
          {
            "name": "type",
            "type": "string",
            "title": {
              "en": "Event type"
            },
            "example": {
              "en": "Motion detection"
            }
          },
          {
            "name": "source",
            "type": "string",
            "title": {
              "en": "Source name"
            },
            "example": {
              "en": "Front door"
            }
          },
          {
            "name": "source_id",
            "type": "string",
            "title": {
              "en": "Source ID"
            },
            "example": {
              "en": "73016_..."
            }
          },
          {
            "name": "time",
            "type": "string",
            "title": {
              "en": "Time"
            },
            "example": {
              "en": "2026-10-13 12:00:00"
            }
          }
        ],
        "id": "acs_event"
      },
      {
        "id": "camera_event",
        "title": {
          "en": "Camera Station sent an event"
        },
        "hint": {
          "en": "Runs when a Camera Station action rule sends an event for this camera to Homey."
        },
        "tokens": [
          {
            "name": "type",
            "type": "string",
            "title": {
              "en": "Event type"
            },
            "example": {
              "en": "Motion detection"
            }
          },
          {
            "name": "time",
            "type": "string",
            "title": {
              "en": "Time"
            },
            "example": {
              "en": "2026-10-13 12:00:00"
            }
          },
          {
            "name": "snapshot",
            "type": "image",
            "title": {
              "en": "Snapshot"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=camera"
          }
        ]
      },
      {
        "id": "server_problem",
        "title": {
          "en": "Camera Station reported a problem"
        },
        "hint": {
          "en": "Disk errors and warnings, and recordings that failed. Repeats of the same problem are held back (see the device settings)."
        },
        "tokens": [
          {
            "name": "problem",
            "type": "string",
            "title": {
              "en": "Problem"
            },
            "example": {
              "en": "Recording failed"
            }
          },
          {
            "name": "description",
            "type": "string",
            "title": {
              "en": "Description"
            },
            "example": {
              "en": "Recording failed: AXIS P3267-LVE"
            }
          },
          {
            "name": "camera",
            "type": "string",
            "title": {
              "en": "Camera"
            },
            "example": {
              "en": "AXIS P3267-LVE"
            }
          },
          {
            "name": "time",
            "type": "string",
            "title": {
              "en": "Time"
            },
            "example": {
              "en": "2026-10-13 12:00"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=server"
          }
        ]
      },
      {
        "id": "recording_failed",
        "title": {
          "en": "Recording failed on a camera"
        },
        "tokens": [
          {
            "name": "camera",
            "type": "string",
            "title": {
              "en": "Camera"
            },
            "example": {
              "en": "AXIS P3267-LVE"
            }
          },
          {
            "name": "time",
            "type": "string",
            "title": {
              "en": "Time"
            },
            "example": {
              "en": "2026-10-13 12:00"
            }
          },
          {
            "name": "reason",
            "type": "string",
            "title": {
              "en": "Reason"
            },
            "example": {
              "en": "Camera not reachable"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=server"
          }
        ]
      },
      {
        "id": "disk_problem",
        "title": {
          "en": "Camera Station has a disk problem"
        },
        "tokens": [
          {
            "name": "problem",
            "type": "string",
            "title": {
              "en": "Problem"
            },
            "example": {
              "en": "Disk full"
            }
          },
          {
            "name": "path",
            "type": "string",
            "title": {
              "en": "Disk or folder"
            },
            "example": {
              "en": "D:\\\\"
            }
          },
          {
            "name": "time",
            "type": "string",
            "title": {
              "en": "Time"
            },
            "example": {
              "en": "2026-10-13 12:00"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=server"
          }
        ]
      },
      {
        "id": "camera_status_changed",
        "title": {
          "en": "A camera went offline or came back"
        },
        "hint": {
          "en": "For every camera in Camera Station, also those not added to Homey."
        },
        "tokens": [
          {
            "name": "camera",
            "type": "string",
            "title": {
              "en": "Camera"
            },
            "example": {
              "en": "AXIS P3267-LVE"
            }
          },
          {
            "name": "time",
            "type": "string",
            "title": {
              "en": "Time"
            },
            "example": {
              "en": "2026-10-13 12:00"
            }
          },
          {
            "name": "online",
            "type": "boolean",
            "title": {
              "en": "Online"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=server"
          }
        ]
      }
    ],
    "actions": [
      {
        "title": {
          "en": "Activate a Camera Station trigger"
        },
        "titleFormatted": {
          "en": "Activate Camera Station trigger [[trigger]] on [[server]]"
        },
        "hint": {
          "en": "Starts the actions of a Camera Station action rule whose trigger is \"Trigger\" with this name."
        },
        "args": [
          {
            "type": "text",
            "name": "trigger",
            "title": {
              "en": "Trigger name"
            },
            "placeholder": {
              "en": "Homey arrival"
            }
          },
          {
            "type": "autocomplete",
            "name": "server",
            "title": {
              "en": "Camera Station"
            },
            "placeholder": {
              "en": "Server"
            }
          }
        ],
        "id": "acs_trigger_activate"
      },
      {
        "title": {
          "en": "Deactivate a Camera Station trigger"
        },
        "titleFormatted": {
          "en": "Deactivate Camera Station trigger [[trigger]] on [[server]]"
        },
        "args": [
          {
            "type": "text",
            "name": "trigger",
            "title": {
              "en": "Trigger name"
            },
            "placeholder": {
              "en": "Homey arrival"
            }
          },
          {
            "type": "autocomplete",
            "name": "server",
            "title": {
              "en": "Camera Station"
            },
            "placeholder": {
              "en": "Server"
            }
          }
        ],
        "id": "acs_trigger_deactivate"
      },
      {
        "title": {
          "en": "Activate a Camera Station trigger for a while"
        },
        "titleFormatted": {
          "en": "Activate Camera Station trigger [[trigger]] for [[seconds]] seconds on [[server]]"
        },
        "args": [
          {
            "type": "text",
            "name": "trigger",
            "title": {
              "en": "Trigger name"
            },
            "placeholder": {
              "en": "Homey arrival"
            }
          },
          {
            "type": "number",
            "name": "seconds",
            "title": {
              "en": "Seconds"
            },
            "min": 0,
            "max": 86400,
            "placeholder": {
              "en": "30"
            }
          },
          {
            "type": "autocomplete",
            "name": "server",
            "title": {
              "en": "Camera Station"
            },
            "placeholder": {
              "en": "Server"
            }
          }
        ],
        "id": "acs_trigger_for"
      },
      {
        "title": {
          "en": "Pulse a Camera Station trigger"
        },
        "titleFormatted": {
          "en": "Pulse Camera Station trigger [[trigger]] on [[server]]"
        },
        "hint": {
          "en": "Activates and immediately deactivates the trigger."
        },
        "args": [
          {
            "type": "text",
            "name": "trigger",
            "title": {
              "en": "Trigger name"
            },
            "placeholder": {
              "en": "Homey arrival"
            }
          },
          {
            "type": "autocomplete",
            "name": "server",
            "title": {
              "en": "Camera Station"
            },
            "placeholder": {
              "en": "Server"
            }
          }
        ],
        "id": "acs_trigger_pulse"
      },
      {
        "id": "take_snapshot",
        "title": {
          "en": "Take a snapshot"
        },
        "hint": {
          "en": "Gives a picture you can use in later cards, for example in a push notification."
        },
        "tokens": [
          {
            "name": "snapshot",
            "type": "image",
            "title": {
              "en": "Snapshot"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=camera"
          }
        ]
      },
      {
        "id": "start_recording",
        "title": {
          "en": "Start manual recording"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=camera"
          }
        ]
      },
      {
        "id": "stop_recording",
        "title": {
          "en": "Stop manual recording"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=camera"
          }
        ]
      },
      {
        "id": "add_bookmark",
        "title": {
          "en": "Add bookmark"
        },
        "titleFormatted": {
          "en": "Add bookmark [[name]] with description [[description]]"
        },
        "hint": {
          "en": "Marks this moment in the camera's recording timeline in Camera Station."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=camera"
          },
          {
            "type": "text",
            "name": "name",
            "title": {
              "en": "Name"
            },
            "placeholder": {
              "en": "Front door opened"
            }
          },
          {
            "type": "text",
            "name": "description",
            "title": {
              "en": "Description"
            },
            "required": false,
            "placeholder": {
              "en": "Optional"
            }
          }
        ]
      },
      {
        "id": "goto_preset",
        "title": {
          "en": "Move to PTZ preset"
        },
        "titleFormatted": {
          "en": "Move to PTZ preset [[preset]]"
        },
        "hint": {
          "en": "Only for PTZ cameras. The presets are the ones set up for the camera."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=camera"
          },
          {
            "type": "autocomplete",
            "name": "preset",
            "title": {
              "en": "Preset"
            },
            "placeholder": {
              "en": "Home"
            }
          }
        ]
      },
      {
        "id": "take_view_snapshot",
        "title": {
          "en": "Take a picture of the view"
        },
        "hint": {
          "en": "All cameras in the view in one picture, like the grid in Camera Station."
        },
        "tokens": [
          {
            "name": "snapshot",
            "type": "image",
            "title": {
              "en": "Picture"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=view"
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "is_recording",
        "title": {
          "en": "Manual recording !{{is|is not}} on"
        },
        "hint": {
          "en": "Manual recording started from Homey or Camera Station."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=camera"
          }
        ]
      },
      {
        "id": "is_online",
        "title": {
          "en": "Camera !{{is|is not}} online"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=camera"
          }
        ]
      },
      {
        "id": "has_problem",
        "title": {
          "en": "Camera Station !{{has|has no}} active problems"
        },
        "hint": {
          "en": "A disk or recording problem alarm is on."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=server"
          }
        ]
      }
    ]
  },
