          },
          "insightsTitleTrue": {
            "en": "Camera went offline"
          },
          "insightsTitleFalse": {
            "en": "Camera came back online"
          }
        }
      },
      "id": "camera",
      "settings": [
        {
          "id": "stream_profile",
          "type": "dropdown",
          "label": {
            "en": "Video quality"
          },
          "hint": {
            "en": "Which of the camera's quality levels in Camera Station to stream. Low is the default and is gentle on Homey. Automatic starts higher and lowers the quality if Homey gets busy. High can be very heavy (some cameras send 4K) and Homey may still lower it to stay responsive."
          },
          "value": "low",
          "values": [
            {
              "id": "auto",
              "label": {
                "en": "Automatic"
              }
            },
            {
              "id": "high",
              "label": {
                "en": "High"
              }
            },
            {
              "id": "medium",
              "label": {
                "en": "Medium"
              }
            },
            {
              "id": "low",
              "label": {
                "en": "Low (recommended)"
              }
            }
          ]
        },
        {
          "id": "snapshot_interval",
          "type": "number",
          "label": {
            "en": "Snapshot refresh (minutes)"
          },
          "hint": {
            "en": "How often the still picture on the device tile is updated. Example: 5. Use 0 to only update when you open the camera."
          },
          "value": 5,
          "min": 0,
          "max": 1440
        },
        {
          "id": "motion_reset",
          "type": "number",
          "label": {
            "en": "Motion alarm duration (seconds)"
          },
          "value": 30,
          "min": 5,
          "max": 3600,
          "hint": {
            "en": "How long the motion alarm stays on after Camera Station reports motion. Example: 30."
          }
        },
        {
          "id": "event_address",
          "type": "label",
          "label": {
            "en": "Address for Camera Station events"
          },
          "value": "",
          "hint": {
            "en": "Paste this address into a \"Send HTTP notification\" action in Camera Station (Configuration > Recording and events > Action rules). Use method GET. Motion and other events for this camera then reach Homey. Keep the address private: it contains a secret key."
          }
        }
      ]
    },
