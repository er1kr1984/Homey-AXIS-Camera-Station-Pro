            "usernameLabel": {
              "en": "Camera Station username"
            },
            "usernamePlaceholder": {
              "en": "axis"
            },
            "passwordLabel": {
              "en": "Password"
            },
            "passwordPlaceholder": {
              "en": "Password"
            }
          },
          "navigation": {
            "next": "list_devices"
