              "en": "Password"
            },
            "passwordPlaceholder": {
              "en": "Password"
            }
          }
        }
      ],
      "id": "camera",
      "settings": [
        {
          "id": "stream_profile",
          "type": "dropdown",
          "label": {
            "en": "Video quality"
          },
          "hint": {
            "en": "Automatic picks the best quality your Homey can handle and lowers it if Homey gets busy. Choose High, Medium or Low to always use that quality level from Camera Station. High can be very heavy (some cameras send 4K) and Homey may still lower it to stay responsive."
          },
          "value": "auto",
          "values": [
            {
              "id": "auto",
              "label": {
                "en": "Automatic (recommended)"
              }
            },
            {
              "id": "high",
              "label": {
                "en": "High"
              }
            },
            {
              "id": "medium",
              "label": {
                "en": "Medium"
              }
            },
            {
              "id": "low",
              "label": {
                "en": "Low"
              }
            }
          ]
        },
        {
          "id": "snapshot_interval",
          "type": "number",
          "label": {
            "en": "Snapshot refresh (minutes)"
          },
          "hint": {
            "en": "How often the still picture on the device tile is updated. Example: 5. Use 0 to only update when you open the camera."
          },
          "value": 5,
          "min": 0,
          "max": 1440
        }
      ]
    }
