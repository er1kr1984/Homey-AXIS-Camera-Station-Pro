{
  "triggers": [
    {
      "id": "server_problem",
      "title": {
        "en": "Camera Station reported a problem",
        "sv": "Camera Station rapporterade ett problem",
        "de": "Camera Station hat ein Problem gemeldet",
        "nl": "Camera Station heeft een probleem gemeld"
      },
      "hint": {
        "en": "Disk errors and warnings, and recordings that failed. Repeats of the same problem are held back (see the device settings).",
        "sv": "Diskfel och diskvarningar samt misslyckade inspelningar. Upprepningar av samma problem hålls tillbaka (se enhetens inställningar).",
        "de": "Festplattenfehler und -warnungen sowie fehlgeschlagene Aufnahmen. Wiederholungen desselben Problems werden zurückgehalten (siehe Geräteeinstellungen).",
        "nl": "Schijffouten en -waarschuwingen, en mislukte opnames. Herhalingen van hetzelfde probleem worden tegengehouden (zie de apparaatinstellingen)."
      },
      "tokens": [
        {
          "name": "problem",
          "type": "string",
          "title": {
            "en": "Problem",
            "sv": "Problem",
            "de": "Problem",
            "nl": "Probleem"
          },
          "example": {
            "en": "Recording failed",
            "sv": "Inspelningen misslyckades",
            "de": "Aufnahme fehlgeschlagen",
            "nl": "Opname mislukt"
          }
        },
        {
