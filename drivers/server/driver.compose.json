      "template": "login_credentials",
      "options": {
        "title": {
          "en": "Log in to Camera Station"
        },
        "usernameLabel": {
          "en": "Camera Station username"
        },
        "usernamePlaceholder": {
          "en": "axis"
        },
        "passwordLabel": {
          "en": "Password"
        },
        "passwordPlaceholder": {
          "en": "Password"
        }
